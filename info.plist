				<key>script</key>
				<string>// Auto-type the password into the frontmost app (needs Accessibility access for Alfred).
ObjC.import("AppKit")

function env(name) {
  const v = $.NSProcessInfo.processInfo.environment.objectForKey(name)
  return v.isNil() ? "" : v.js
}

function run(argv) {
  const password = argv[0] || ""
  if (!password) return

  // Wait for the shortcut's modifier keys (⇧⌃⌥⌘) to be released, then for Alfred to hide.
  for (let i = 0; i &lt; 60 &amp;&amp; ($.NSEvent.modifierFlags &amp; 0x1E0000); i++) delay(0.05)
  delay(0.3)

  const ms = parseInt(env("laps_typedelay"), 10)
  const pause = (isNaN(ms) ? 20 : ms) / 1000
  const events = Application("System Events")
  for (const ch of password) {
    events.keystroke(ch)
    if (pause) delay(pause)
  }
  if (["1", "true"].includes(env("laps_typereturn"))) events.keyCode(36)
}</string>
